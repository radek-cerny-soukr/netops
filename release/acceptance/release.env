# Input of upgrade-check.sh for the upgrade 1.0.3 -> 1.0.4.
# FROM_IMAGE is the published NetOps 1.0.3 image index.
# TO_IMAGE is a local tag of the candidate image on the test host; set it to the candidate under test before a run.
# from/ is not tracked: before a run, fill it from tag v1.0.3, for example
#   mkdir -p from && git show v1.0.3:compose.yaml > from/compose.yaml && git show v1.0.3:docs/quickstart-1.0.md > from/quickstart-1.0.md
# Without it upgrade-check.sh stops with exit 2.
FROM_IMAGE=ghcr.io/radek-cerny-soukr/netops@sha256:0ddf246ca5e22f7df89abb9cf8f7c9fd10920eec39b4a02ad7fddac04a3b65ce
TO_IMAGE=netops-acck151855:1e65e97
FROM_COMPOSE=from/compose.yaml
FROM_QUICKSTART=from/quickstart-1.0.md
TO_COMPOSE=../../compose.yaml
TO_QUICKSTART=../../docs/quickstart-1.0.md
SERVER_NAME=localhost
PORT=18443
BIND_IP=127.0.0.1
WORKDIR=/tmp/netops-upgrade-check
DOCKER="sudo -n docker"
