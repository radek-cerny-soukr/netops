# Input of upgrade-check.sh for the upgrade 1.0.2 -> 1.0.3.
# FROM_IMAGE is the published NetOps 1.0.2 image index.
# TO_IMAGE is a local tag of the candidate image on the test host; set it to the candidate under test before a run.
# from/ is not tracked: before a run, fill it from tag v1.0.2, for example
#   mkdir -p from && git show v1.0.2:compose.yaml > from/compose.yaml && git show v1.0.2:docs/quickstart-1.0.md > from/quickstart-1.0.md
# Without it upgrade-check.sh stops with exit 2.
FROM_IMAGE=ghcr.io/radek-cerny-soukr/netops@sha256:432040717c7630ee5f08347d0c59682bec9f896dc3728ac0690bb8f86aa13413
TO_IMAGE=netops-acck151855:1e65e97
FROM_COMPOSE=from/compose.yaml
FROM_QUICKSTART=from/quickstart-1.0.md
TO_COMPOSE=../../compose.yaml
TO_QUICKSTART=../../docs/quickstart-1.0.md
SERVER_NAME=localhost
PORT=18443
BIND_IP=127.0.0.1
WORKDIR=/tmp/netops-upgrade-check
DOCKER="sudo -n docker"
