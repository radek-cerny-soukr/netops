# Input of upgrade-check.sh for the upgrade 1.0.7 -> 1.0.8.
# FROM_IMAGE is the published NetOps 1.0.7 image index.
# TO_IMAGE is a local tag of the candidate image on the test host; set it to the candidate under test before a run.
# from/ is not tracked: before a run, fill it from tag v1.0.7, for example
#   mkdir -p from && git show v1.0.7:compose.yaml > from/compose.yaml && git show v1.0.7:docs/quickstart-1.0.md > from/quickstart-1.0.md
# Without it upgrade-check.sh stops with exit 2.
# DOCKER is the docker command of upgrade-check.sh. The default "sudo -n docker" suits an account with sudo.
# An operator in the docker group without sudo, as the quickstart assumes, sets DOCKER=docker.
# WORKDIR is the scratch directory of a run; it can be changed to a directory in the operator's home.
FROM_IMAGE=ghcr.io/radek-cerny-soukr/netops@sha256:e04b19091819897e1bb4dec11416253b1dd598c18d5567325583b7e7e5fb8dfc
TO_IMAGE=netops-candidate:1.0.8
FROM_COMPOSE=from/compose.yaml
FROM_QUICKSTART=from/quickstart-1.0.md
TO_COMPOSE=../../compose.yaml
TO_QUICKSTART=../../docs/quickstart-1.0.md
SERVER_NAME=localhost
PORT=18443
BIND_IP=127.0.0.1
WORKDIR=/tmp/netops-upgrade-check
DOCKER="sudo -n docker"
