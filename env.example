NETOPS_IMAGE=replace-me-with-signed-release-image-at-sha256-digest
NETOPS_BIND_IP=replace-me-with-explicit-host-bind-address
NETOPS_PORT=8443
NETOPS_SERVER_NAME=replace-me-with-certificate-dns-name
# NETOPS_CPUS sets the container CPU quota (default: 2); raise it on a stronger host (e.g. 4),
# and on a host with 1 CPU set NETOPS_CPUS=1. It does not change how many requests run at once.
# NETOPS_CPUS=1
# NETOPS_MEMORY is the container memory (default: 1g); raise it on a stronger host (e.g. 2g).
# NETOPS_MEMORY=2g
