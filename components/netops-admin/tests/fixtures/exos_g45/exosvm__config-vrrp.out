#
# Module vlan configuration.
#
configure vlan default delete ports all
configure vr VR-Default delete ports 1-12
create qosprofile "QP2"
create qosprofile "QP3"
create qosprofile "QP4"
create qosprofile "QP5"
create qosprofile "QP6"
create qosprofile "QP7"
create vlan "B04-DATA"
configure vlan B04-DATA tag 304
create vlan "B04-ISC"
configure vlan B04-ISC tag 4090
create vlan "B04-KA"
configure vlan B04-KA tag 4091
create vlan "D10"
configure vlan D10 tag 10
create vlan "D20"
configure vlan D20 tag 20
create vlan "g45m"
configure vlan g45m description "g45 test" 
enable ipforwarding ipv6 vlan g45m
configure vlan g45m tag 3945
enable sharing 5 grouping 5 lacp
configure vlan B04-DATA add ports 3 tagged  
configure vlan B04-DATA add ports 5 untagged  
configure vlan B04-ISC add ports 3 tagged  
configure vlan B04-KA add ports 4 untagged  
configure vlan D10 add ports 1 tagged  
configure vlan D10 add ports 2 untagged  
configure vlan D20 add ports 1 tagged  
configure vlan Default add ports 6-12 untagged  
configure vlan B04-ISC ipaddress 192.0.2.193 255.255.255.252
configure vlan B04-KA ipaddress 192.0.2.197 255.255.255.252
configure vlan D10 ipaddress 192.0.2.132 255.255.255.224
configure vlan D20 ipaddress 192.0.2.164 255.255.255.224
configure vlan g45m ipaddress 198.51.100.1 255.255.255.0
enable ipforwarding vlan g45m
configure vlan Mgmt ipaddress 192.0.2.54 255.255.255.128
configure vlan g45m ipaddress eui64 fe80::/64
configure vlan g45m ipaddress 2001:db8:45::1/64
configure qosscheduler strict-priority ports 1 
configure qosscheduler strict-priority ports 2 
configure qosscheduler strict-priority ports 3 
configure qosscheduler strict-priority ports 4 
configure qosscheduler strict-priority ports 5 
configure qosscheduler strict-priority ports 6 
configure qosscheduler strict-priority ports 7 
configure qosscheduler strict-priority ports 8 
configure qosscheduler strict-priority ports 9 
configure qosscheduler strict-priority ports 10 
configure qosscheduler strict-priority ports 11 
configure qosscheduler strict-priority ports 12 
#
# Module rtmgr configuration.
#
configure iproute add default 192.0.2.1 vr VR-Mgmt
configure iproute add 203.0.113.0 255.255.255.0 198.51.100.254
configure iproute add 203.0.113.128 255.255.255.128 198.51.100.253
configure iproute add 2001:db8:4545::/64 2001:db8:45::fe
configure iproute add 2001:db8:4546::/64 2001:db8:45::fd
#
# Module vrrp configuration.
#
create vrrp vlan g45m vrid 45
configure vrrp vlan g45m vrid 45 priority 200
configure vrrp vlan g45m vrid 45 add 198.51.100.254
enable vrrp vlan g45m vrid 45
