# Module vlan configuration.
create vlan "netops-g48"
# Module vlan configuration.
configure vlan netops-g48 tag 3940
# Module vlan configuration.
configure vlan netops-g48 add ports 10 tagged
# Module vlan configuration.
configure vlan netops-g48 ipaddress 192.0.2.1    255.255.255.0
# Module vlan configuration.
enable ipforwarding vlan netops-g48
# Module netTools configuration.
configure vlan netops-g48 dhcp-address-range 192.0.2.30    - 192.0.2.49
# Module netTools configuration.
configure vlan netops-g48 dhcp-lease-timer 3600
# Module netTools configuration.
configure vlan netops-g48 dhcp-options default-gateway 192.0.2.1
# Module netTools configuration.
configure vlan netops-g48 dhcp-options dns-server 192.0.2.2
# Module netTools configuration.
configure vlan netops-g48 dhcp-options dns-server secondary 192.0.2.3
# Module netTools configuration.
enable dhcp ports 10 vlan netops-g48
