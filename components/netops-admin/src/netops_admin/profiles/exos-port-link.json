    },
    "jumbo-frame": {
      "type": "text",
      "update": true,
      "unset": true,
      "referenced_update": true,
      "required_on_create": false,
      "pattern": "^(enabled|disabled)$",
      "max_length": 32,
      "default": "disabled"
    }
  },
  "fixed": {},
  "volatile": [],
  "reserved_values": {},
  "inverse_identity_changes": {},
  "rollback_evidence": "Read the configured AutoNeg, Speed and Duplex columns and per-port Jumbo setting. Undo restores the prior configured values.",
