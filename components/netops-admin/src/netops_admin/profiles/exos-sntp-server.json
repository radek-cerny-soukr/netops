{
  "platform": "exos",
  "table": "sntp-server",
  "versions": [
    "33.6.1.14",
    "33.7.1.6"
  ],
  "ops": [
    "update"
  ],
  "table_scoped_key": true,
  "key_pattern": "^(?:primary|secondary)$",
  "protected_keys": [],
  "attributes": {
    "server": {
      "type": "text",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]{0,252}$",
      "max_length": 253,
      "required_on_create": false,
      "update": true,
      "unset": false,
      "referenced_update": true
    },
    "vr": {
      "type": "text",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
      "max_length": 32,
      "required_on_create": false,
      "update": true,
      "unset": false,
      "referenced_update": true
    }
  },
  "fixed": {},
  "volatile": [],
  "reserved_values": {},
  "inverse_identity_changes": {},
  "rollback_evidence": "Update an existing primary or secondary slot with a saved server and VR. Undo reinstates both. Readback uses the check account. Changes are applied to running configuration."
}
