{
  "platform": "fortiadc",
  "table": "load-balance real-server",
  "versions": [
    "7.6.7 build0676"
  ],
  "exact_versions": true,
  "table_scoped_key": true,
  "ops": [
    "create",
    "update"
  ],
  "key_pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
  "protected_keys": [],
  "attributes": {
    "type": {
      "type": "text",
      "default": "ip",
      "update": false,
      "unset": false,
      "referenced_update": false,
      "max_length": 4,
      "pattern": "^(ip|fqdn)$",
      "required_on_create": false
    },
    "ip": {
      "type": "ipv4-address",
      "update": true,
      "unset": false,
      "referenced_update": true,
      "required_on_create": false
    },
    "fqdn": {
      "type": "text",
      "update": true,
      "unset": false,
      "referenced_update": true,
      "max_length": 253,
      "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
      "required_on_create": false
    },
    "status": {
      "type": "text",
      "default": "enable",
      "update": true,
      "unset": false,
      "referenced_update": true,
      "max_length": 8,
      "pattern": "^(enable|disable|maintain)$",
      "undo_to_default": true,
      "required_on_create": false
    }
  },
  "fixed": {
    "server-type": "static"
  },
  "volatile": [],
  "reserved_values": {},
  "inverse_identity_changes": {},
  "rollback_evidence": "The Admin engine verifies the change with the check account and restores the previous configuration through the inverse CLI commands. FortiADC has no on-device timer used by Admin.",
  "undo_ops": [
    "delete"
  ]
}
