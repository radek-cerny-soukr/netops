show full-configuration load-balance virtual-server LAB_VS_HTTPS
config load-balance virtual-server
  edit "LAB_VS_HTTPS"
    set status enable
    set type l7-load-balance
    set multi-process 1
    set interface port2
    set addr-type ipv4
    set ip 203.0.113.10
    set public-ip-type ipv4
    set public-ip 0.0.0.0
    set port 443 
    set protocol-numbers 0 
    set connection-limit 0
    set load-balance-profile LB_PROF_HTTPS
    unset dos-profile
    set client-ssl-profile LB_CLIENT_SSL_PROF_DEFAULT
    set content-rewriting disable
    set schedule-list disable
    set content-routing enable
    set content-routing-list NETOPS_TEST_CR1 NETOPS_TEST_CR2 
    set load-balance-persistence LB_PERSIS_SRC_ADDR
    set load-balance-method LB_METHOD_ROUND_ROBIN
    unset connection-pool
    unset ippool-list
    set traffic-log enable
    set alone enable
    set warm-up 0
    set warm-rate 100
    unset error-page
    set error-msg Server-unavailable!
    set trans-rate-limit 0
    unset waf-profile
    unset auth-policy
    set scripting-flag disable
    unset pagespeed
    unset comments
    set ssl-mirror disable
    unset traffic-group
    set fortiview disable
    set http2https disable
    set http2https-port 80 
    set max-persistence-entries 262144
    unset av-profile
    unset clone-pool
    set clone-traffic-type both-sides
    set wccp disable
    set one-click-gslb-server-option disable
    set stream-scripting-flag disable
    unset ztna-profile
    set ingress-tag 0
  next
end

